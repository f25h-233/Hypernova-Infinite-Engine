# ---- 测试用游戏包（体积巨大，只在本机存在）----
# 这里只是方便本地跑测试，不属于本项目源码，永不入库
Starsector-098-260mods/
Starsector-098-Base/

# ---- 构建产物（注意：mod 的成品 jar 不在忽略之列，星区 mod 通常要随仓库分发）----
build/
out/
*.class
*.tmp

# ---- 操作系统 / 编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.iml

# ---- 日志与本地备份 ----
*.log
*.bak
*.bak-*
~$*

# ---- Nezha IDE 本地配置 ----
.nezha/

# ---- 逆向研究产物（含游戏反编译代码，永不入库）----
.research/

# 本地测试包压缩文件（体积巨大，永不入库）
*.7z
build/java/
lib/

# 分发产物（manifest 由 tools/trim_manifest.py 生成，不入库大文件）
dist/

# Python 缓存（pytest 会在 tools/ 与 tests/ 下生成）
__pycache__/
*.pyc
