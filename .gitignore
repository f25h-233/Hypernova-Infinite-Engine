# ---- 测试用游戏包（体积巨大，只在本机存在）----
# 这里只是方便本地跑测试，不属于本项目源码，永不入库
Starsector-098-260mods/
Starsector-098-Base/

# ---- 构建产物（注意：mod 的成品 jar 不在忽略之列，星区 mod 通常要随仓库分发）----
build/
out/
*.class
*.tmp

# ---- 本地第三方工件缓存（FR 0.9.7rc2 等；哈希记录在 docs/m1f-results.md）----
.cache/

# ---- 操作系统 / 编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.iml

# ---- 日志与本地备份 ----
*.log
*.bak
*.bak-*
~$*

# ---- Nezha IDE 本地配置 ----
.nezha/

# ---- 逆向研究产物（含游戏反编译代码，永不入库）----
.research/

# 本地测试包压缩文件（体积巨大，永不入库）
*.7z
build/java/
lib/

# 分发产物（manifest 由 tools/trim_manifest.py 生成，不入库大文件）
dist/

# Python 缓存（pytest 会在 tools/ 与 tests/ 下生成）
__pycache__/
*.pyc

# ---- M6 审计工作区：只提交脚本清单与证据摘要 ----
SS098_Hypernova_Compat_AuditTest/mods/
SS098_Hypernova_Compat_AuditTest/vmparams/
SS098_Hypernova_Compat_AuditTest/backups/
SS098_Hypernova_Compat_AuditTest/evidence/*.csv
SS098_Hypernova_Compat_AuditTest/evidence/**/*.csv
SS098_Hypernova_Compat_AuditTest/evidence/**/*.dump
SS098_Hypernova_Compat_AuditTest/evidence/**/*.log
SS098_Hypernova_Compat_AuditTest/evidence/**/screens/
# m6_session 的实际产物在 <audit-root>/<label>/（不是 evidence/<label>/）。
# `evidence/*.json` 与 `<label>/session*.json` 仍可入库。
SS098_Hypernova_Compat_AuditTest/**/screens/
SS098_Hypernova_Compat_AuditTest/**/logs/
SS098_Hypernova_Compat_AuditTest/**/*.csv
SS098_Hypernova_Compat_AuditTest/**/*.dump

# ---- M7 统一部署包：实验安装与第三方工件永不入库 ----
SS098_Hypernova_Compat_AuditTest/install/
SS098_Hypernova_Compat_AuditTest/vendor/
# route-* --apply 生成的启动器，不是仓库预置文件
